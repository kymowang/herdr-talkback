#!/bin/sh
# Pre-commit hook: keep the declared patch version moving with each change.
#
# The version lives in three files that must always agree and must move whenever
# code changes, so it is bumped before the commit is created and folded into it.
#
# Bumping in pre-push cannot work: git resolves the refs to push before that hook
# runs, so a commit created there never reaches the remote with the same push.
#
# This is a thin shell wrapper because git invokes hooks through its own shell.
# The interpreter is chosen by running it, not by looking it up: on Windows,
# `python3` often resolves to a Microsoft Store stub that fails at runtime while
# a real `python` is available.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c '' >/dev/null 2>&1; then
        exec "$candidate" tools/version_hook.py
    fi
done

echo "pre-commit: no working Python interpreter found; commit aborted." >&2
exit 1
